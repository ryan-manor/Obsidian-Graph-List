{
  "name": "obsidian-better-links",
  "version": "0.1.0",
  "description": "The local graph as a ranked list, with unlinked mentions",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck -p .",
    "test": "node esbuild.tests.mjs && node --test \"build-tests/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.0"
  }
}
