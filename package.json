{
  "name": "obsidian-graph-list",
  "version": "0.1.1",
  "description": "The local graph as a ranked list, with unlinked mentions",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck -p .",
    "test": "node esbuild.tests.mjs && node --test \"build-tests/*.test.mjs\"",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0"
  }
}
